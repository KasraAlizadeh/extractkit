# Copy this file to .env and fill in your real values.
# The .env file is gitignored and must never be committed.

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model to use for extraction (gpt-4o-mini is cheap and capable)
EXTRACTKIT_MODEL=gpt-4o-mini

# Optional: requests per minute limit (helps avoid rate limits)
EXTRACTKIT_RPM_LIMIT=60
